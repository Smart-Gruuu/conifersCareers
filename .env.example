# Copy to .env.local and fill in. .env.local is gitignored.
#
# Applications submitted at /careers/<role> are emailed through Brevo's
# transactional email API. Free tier: 300 emails/day, attachments up to 25MB —
# far more than a careers page needs.
#
# Setup, once:
#   1. Create a free account at https://www.brevo.com (no card required).
#   2. Verify hello@conifers.work as a sender, or verify the conifers.work
#      domain. Brevo will not send from an unverified sender.
#   3. Create an API key (SMTP & API -> API keys) and paste it below.
#   4. Turn off Brevo's IP blocking, or it will reject calls from addresses it
#      has not seen before: your name (top right) -> Security -> Authorised IPs
#      -> turn off "Block unknown IP addresses".
#      This matters in production too: on a serverless host (Vercel, Netlify,
#      Lambda) the outbound IP is dynamic, so an allowlist cannot be kept
#      current. Only use the allowlist if you deploy behind a static IP.
#
# REQUIRED.
BREVO_API_KEY=

# Optional. Overrides the destination — handy for pointing a staging deploy at
# a test inbox. Defaults to CAREERS_EMAIL in lib/company.ts.
APPLICATIONS_TO=

# Optional. The envelope sender; must be a sender verified in Brevo.
# Defaults to CAREERS_EMAIL.
APPLICATIONS_FROM=
